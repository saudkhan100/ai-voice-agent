# Copy to .env and fill in. Never commit .env.
ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
SECRET_KEY=change-me
LEAD_API_KEY=change-me

# Matches scripts/setup_local_db.sql
DATABASE_URL=postgresql+asyncpg://dealer:dealer@localhost:5432/dealer_ai

TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_RECORD_CALLS=true

# Used in the agent prompt
DEALERSHIP_NAME=the dealership
AGENT_NAME=Alex

# gemini | openai
VOICE_ENGINE=gemini
GOOGLE_API_KEY=
# empty = Pipecat default (gemini-2.5-flash-native-audio-preview-12-2025 / gpt-realtime-2.1)
GEMINI_LIVE_MODEL=
GEMINI_VOICE=Charon
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

MAX_CONCURRENT_CALLS=2
MAX_CALL_SECONDS=600

# docker-compose only
POSTGRES_PASSWORD=change-me
DOMAIN=calls.example.com
